def inject_sensor_noise(frame, noise_rate=0.12, missing_rate=0.05,
                        drift_rate=0.02, seed=42):
    rng = np.random.default_rng(seed)
    out = frame.copy()
    n = len(out)
    for s in EVIDENCE_VARS:
        flip = rng.random(n) < noise_rate
        shift = rng.choice([-1, 1], size=n)
        out.loc[flip, s] = np.clip(out.loc[flip, s] + shift[flip], 0, 2)
    for s in EVIDENCE_VARS:
        miss = rng.random(n) < missing_rate
        out.loc[miss, s] = -1
    dn = int(n * drift_rate)
    if dn:
        s_drift = rng.choice(EVIDENCE_VARS)
        idx = rng.choice(n, size=dn, replace=False)
        out.loc[idx, s_drift] = np.clip(out.loc[idx, s_drift] + 1, 0, 2)
    return out

