# Mutual Information
mi_recs = [{"Sensor": s, "MI": float(mutual_info_score(test_df[s], test_df[TARGET]))}
           for s in EVIDENCE_VARS]
mi_df = pd.DataFrame(mi_recs).sort_values("MI", ascending=False).reset_index(drop=True)
mi_df["MI Rank"] = mi_df.index + 1

# Variance Reduction
base_p = float(test_df[TARGET].mean())
v_prior = base_p * (1 - base_p)
vr_recs = []
for s in EVIDENCE_VARS:
    cond = []
    for st in range(cards[s]):
        ev = {s: st, **{v: int(test_df[v].mode()[0])
                        for v in EVIDENCE_VARS if v != s}}
        try:
            cond.append(engine.query(variables=[TARGET], evidence=ev).values[1])
        except Exception:
            cond.append(base_p)
    cond = np.array(cond)
    vr_recs.append({"Sensor": s, "VR": v_prior - np.mean(cond * (1 - cond))})
vr_df = pd.DataFrame(vr_recs).sort_values("VR", ascending=False).reset_index(drop=True)
vr_df["VR Rank"] = vr_df.index + 1

