# CELL 15 — Prior sensitivity analysis
# ============================================================
priors = [0.01, 0.05, 0.10, 0.20, 0.50, 0.90]
prior_records = []

train, temp = train_test_split(df_tier3, test_size=0.30,
                               stratify=df_tier3[TARGET], random_state=42)
_, test_p = train_test_split(temp, test_size=0.50,
                              stratify=temp[TARGET], random_state=42)

for pr in priors:
    m = BayesianNetwork(edges)
    c = infer_cardinalities(train)
    for node in m.nodes():
        parents = list(m.predecessors(node))
        if node == TARGET:
            cpd = TabularCPD(variable=TARGET, variable_card=2,
                             values=[[1 - pr], [pr]])
            m.add_cpds(cpd)
        else:
            m.add_cpds(estimate_cpt(node, parents, train, c))
    eng = VariableElimination(m)
    probs = []
    for _, row in test_p.iterrows():
        ev = {v: int(row[v]) for v in EVIDENCE_VARS
              if 0 <= int(row[v]) < c[v]}
        try:
            res = eng.query(variables=[TARGET], evidence=ev, show_progress=False)
            probs.append(float(res.values[1]))
        except Exception:
            probs.append(pr)
    try:
        auc = roc_auc_score(test_p[TARGET], probs)
    except ValueError:
        auc = float("nan")
    prior_records.append({"Prior": pr, "AUC": auc})

