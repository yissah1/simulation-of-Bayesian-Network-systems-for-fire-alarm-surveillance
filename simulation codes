model = d["model"]

def cpt_to_dataframe(model, node):
    cpd = model.get_cpds(node)
    values = cpd.get_values()
    parents = cpd.variables[1:]
    if not parents:
        return pd.DataFrame(values.ravel(),
                            index=[f"{node}={i}" for i in range(cpd.variable_card)],
                            columns=["Probability"])
    pc = cpd.cardinality[1:]
    combos = list(product(*[range(c) for c in pc]))
    columns = [f"{node}={i}" for i in range(cpd.variable_card)]
    index = ["|".join(f"{p}={v}" for p, v in zip(parents, combo))
             for combo in combos]
    return pd.DataFrame(values.T, index=index, columns=columns)

for node in model.nodes():
    cpt_df = cpt_to_dataframe(model, node)
    cpt_df.to_csv(os.path.join(RES_DIR, f"cpt_{node}.csv"))
