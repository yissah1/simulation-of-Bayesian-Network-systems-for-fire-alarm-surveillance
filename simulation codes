def fault_test(frame, engine, cards, fault="missing", rate=0.20, theta=0.07):
    rng = np.random.default_rng(42)
    df_f = frame.copy()
    idxs = rng.choice(df_f.index, size=int(len(df_f) * rate), replace=False)
    for idx in idxs:
        s = rng.choice(EVIDENCE_VARS)
        if fault == "missing":  df_f.loc[idx, s] = -1
        elif fault == "drift":  df_f.loc[idx, s] = min(int(df_f.loc[idx, s]) + 1, 2)
        elif fault == "stuck":  df_f.loc[idx, s] = 2
    probs = batch_posterior(engine, df_f, cards).values
    yp = (probs >= theta).astype(int)
    acc = accuracy_score(df_f[TARGET], yp)
    f1 = f1_score(df_f[TARGET], yp, zero_division=0)
    return {"Fault": fault, "Rate": rate, "Accuracy": acc, "F1": f1}

