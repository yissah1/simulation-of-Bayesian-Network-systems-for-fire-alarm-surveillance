def discretise_tertiles(series):
    try:
        return pd.qcut(series, q=3, labels=[0, 1, 2],
                       duplicates='drop').astype(int)
    except ValueError:
        return pd.cut(series, bins=3, labels=[0, 1, 2]).astype(int)

