# CELL 9 — Laplace smoothing parameter optimisation
# ============================================================
def build_model_with_alpha(frame, alpha):
    m = BayesianNetwork(edges)
    cards = infer_cardinalities(frame)
    for node in m.nodes():
        parents = list(m.predecessors(node))
        m.add_cpds(estimate_cpt(node, parents, frame, cards, alpha=max(alpha, 1e-9)))
    return m

train, temp = train_test_split(df_tier3, test_size=0.30,
                               stratify=df_tier3[TARGET], random_state=42)
valid, _ = train_test_split(temp, test_size=0.50,
                            stratify=temp[TARGET], random_state=42)

recs = []
for a in [0.0, 0.5, 1.0, 2.0, 5.0]:
    m = build_model_with_alpha(train, a)
    eng = VariableElimination(m)
    cards = infer_cardinalities(train)
    sample = valid.sample(1500, random_state=1)
    p = batch_posterior(eng, sample, cards).values
    p = np.clip(p, 1e-9, 1 - 1e-9)
    y = sample[TARGET].values
    ll = np.mean(y * np.log(p) + (1 - y) * np.log(1 - p))
    recs.append({"α": a, "log-likelihood": ll})

