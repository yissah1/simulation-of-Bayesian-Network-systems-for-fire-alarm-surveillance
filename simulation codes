# CELL 6 — BN construction and evaluation utilities
# ============================================================
edges = [(TARGET, "Smoke"), (TARGET, "Temperature"),
         (TARGET, "CO"),    ("Humidity", "Smoke")]

def infer_cardinalities(frame):
    return {c: max(int(frame[c].max()) + 1, 2) for c in frame.columns}

def estimate_cpt(node, parents, frame, cards, alpha=LAPLACE_ALPHA):
    nc = cards[node]
    if not parents:
        counts = frame[node].value_counts().reindex(range(nc), fill_value=0)
        probs = (counts.values + alpha) / (counts.sum() + alpha * nc)
        return TabularCPD(variable=node, variable_card=nc,
                          values=probs.reshape(-1, 1))
    pc = [cards[p] for p in parents]
    combos = list(product(*[range(c) for c in pc]))
    cols = []
    for combo in combos:
        mask = pd.Series(True, index=frame.index)
        for p, v in zip(parents, combo):
            mask &= (frame[p] == v)
        sub = frame.loc[mask]
        counts = sub[node].value_counts().reindex(range(nc), fill_value=0)
        cols.append((counts.values + alpha) / (counts.sum() + alpha * nc))
    return TabularCPD(variable=node, variable_card=nc,
                      values=np.array(cols).T,
                      evidence=parents, evidence_card=pc)

def build_model(frame):
    m = BayesianNetwork(edges)
    cards = infer_cardinalities(frame)
    for node in m.nodes():
        parents = list(m.predecessors(node))
        m.add_cpds(estimate_cpt(node, parents, frame, cards))
    assert m.check_model()
    return m, cards

def batch_posterior(engine, frame, cards):
    probs = []
    for _, row in frame.iterrows():
        ev = {v: int(row[v]) for v in EVIDENCE_VARS
              if 0 <= int(row[v]) < cards[v]}
        try:
            r = engine.query(variables=[TARGET], evidence=ev, show_progress=False)
            probs.append(float(r.values[1]))
        except Exception:
            probs.append(float("nan"))
    return pd.Series(probs, index=frame.index, name="P_Fire")

def tune_threshold_recall(engine, valid_df, cards, target_recall=0.90):
    probs = batch_posterior(engine, valid_df, cards).values
    y = valid_df[TARGET].values
    fires = y == 1
    if fires.sum() == 0:
        return 0.50
    best_t = 0.05
    for t in np.round(np.arange(0.05, 0.95, 0.01), 2):
        recall = ((probs >= t) & fires).sum() / fires.sum()
        if recall >= target_recall:
            best_t = float(t)
        else:
            break
    return best_t

def evaluate(engine, test_df, cards, theta):
    probs = batch_posterior(engine, test_df, cards)
    y = test_df[TARGET].values
    yp = (probs.values >= theta).astype(int)
    cm = confusion_matrix(y, yp)
    tn, fp, fn, tp = cm.ravel() if cm.size == 4 else (0, 0, 0, 0)
    return {
        "Accuracy":    accuracy_score(y, yp),
        "Precision":   precision_score(y, yp, zero_division=0),
        "Recall":      recall_score(y, yp, zero_division=0),
        "Specificity": tn / (tn + fp) if (tn + fp) else 0.0,
        "F1":          f1_score(y, yp, zero_division=0),
        "AUC-ROC":     roc_auc_score(y, probs.values) if len(set(y)) > 1 else float("nan"),
        "FPR":         fp / (fp + tn) if (fp + tn) else 0.0,
        "FNR":         fn / (fn + tp) if (fn + tp) else 0.0,
        "TP": int(tp), "FP": int(fp), "TN": int(tn), "FN": int(fn),
    }, probs, yp

